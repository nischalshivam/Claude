# generated test media + isolated test job roots (harness regenerate karta hai)
tests/fixtures/
tests/tmp/

# stray media
*.mp4
!tests/**/*.expected.mp4
*.rgb
*.gray
*.log
# RAW-*-LOG.txt release evidence hain — ye ZIP mein jaate hain (ignore NAHI)

# DATA/ user ke apne dhoondhe hue media ka folder hai — repo mein kabhi nahi
DATA/

# project/ = M5 editor ka EDL, revisions aur cache (user work-product) — repo mein nahi
project/

# reference-pack ka JSON user ke script ki lines rakhta hai (script_cue_exact)
# — wo repo mein nahi jayega. ZIP mein bheja jata hai. PADHO.txt commit hoti hai.
reference-pack/*.json
